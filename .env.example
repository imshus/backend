# Copy this file to .env and fill in real values.
# All values below are placeholders — create fresh accounts/keys, do not reuse anyone else's.

NODE_ENV=development
PORT=3000

# --- Database ---
MONGODB_URI=
REDIS_URL=

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- AI (tag scanning) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- SMS OTP (MSG91) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Transactional email (optional) ---
RESEND_API_KEY=

# --- Payments (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- GST verification (Masters India) ---
MASTERS_INDIA_CLIENT_ID=
MASTERS_INDIA_CLIENT_SECRET=
MASTERS_INDIA_USERNAME=
MASTERS_INDIA_PASSWORD=

# --- Optional tuning (safe to leave at defaults) ---
BILLING_TIMEZONE=Asia/Kolkata
MCX_SCHEDULER_TIMEZONE=Asia/Kolkata
MCX_TRADING_DAYS=1,2,3,4,5
MCX_TRADING_START_TIME=09:00:00
MCX_TRADING_END_TIME=23:55:00
MCX_POLL_INTERVAL_SECONDS=140
MAX_UPLOAD_MB=80
OCR_MAX_EDGE_PX=2200
OCR_JPEG_QUALITY=82
