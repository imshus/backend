# Copy this file to .env and fill in real values.
# All values below are placeholders — create fresh accounts/keys, do not reuse anyone else's.

NODE_ENV=development
PORT=3000

# --- Database ---
MONGODB_URI=
REDIS_URL=

# Invoice PDFs are cached in Redis for fast QR-code downloads. MongoDB and
# PDFMonkey remain the durable fallback when a cached copy expires.
INVOICE_PDF_CACHE_TTL_SECONDS=604800
INVOICE_PDF_CACHE_MAX_MB=15

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- AI (tag scanning) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- SMS OTP (MSG91) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Transactional email (optional) ---
RESEND_API_KEY=

# --- Invoice PDF generation ---
PDFMONKEY_API_SECRET=
PDFMONKEY_TEMPLATE_ID=
PUBLIC_BASE_URL=https://api.example.com

# --- Payments (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- GST verification (Masters India) ---
MASTERS_INDIA_CLIENT_ID=
MASTERS_INDIA_CLIENT_SECRET=
MASTERS_INDIA_USERNAME=
MASTERS_INDIA_PASSWORD=

# --- Optional tuning (safe to leave at defaults) ---
BILLING_TIMEZONE=Asia/Kolkata
MCX_SCHEDULER_TIMEZONE=Asia/Kolkata
MCX_TRADING_DAYS=1,2,3,4,5
MCX_TRADING_START_TIME=09:00:00
MCX_TRADING_END_TIME=23:55:00
MCX_POLL_INTERVAL_SECONDS=140
MAX_UPLOAD_MB=80
# The pixels the reader keeps. The magnified parts are cut from this image, so
# a lower value costs accuracy on small print; the app uploads 2400.
OCR_MAX_EDGE_PX=2400
OCR_JPEG_QUALITY=82
# Accuracy stages, all on by default. MULTI_VIEW sends magnified parts of each
# image beside the whole one; DOUBLE_READ runs a second independent read and
# compares them; ADJUDICATE asks a third time about whatever the two disagree
# on. Set any to false to trade accuracy for cost.
OCR_MULTI_VIEW=true
OCR_DOUBLE_READ=true
OCR_ADJUDICATE=true

# Reasoning effort for the OCR model (minimal|low|medium|high). minimal is fastest.
# minimal is the fastest and the least accurate on small print; low is the
# setting the production server runs and what the accuracy work assumes.
OPENAI_REASONING_EFFORT=low
